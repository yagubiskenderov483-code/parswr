# Telegram API (my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Строка сессии юзербота — создаётся командой: python3 generate_session.py
SESSION_STRING=

# Токен бота от @BotFather (нужен для кнопок; бот должен быть админом канала).
# Если пусто — карточки шлёт юзер-аккаунт без кнопок.
BOT_TOKEN=

# Куда постить: @username, -100... id или инвайт-ссылка https://t.me/+hash
# Если знаешь id канала — лучше задать CHANNEL_ID (не дергает ImportChatInvite)
TARGET_CHANNEL=
CHANNEL_ID=

# Диапазон цены в Stars
MIN_STARS=500
MAX_STARS=900

# Пауза между постами в канал (сек)
POST_INTERVAL=3
# Страниц resale на коллекцию за проход
SCAN_PAGES=2
PAGE_LIMIT=25

# Сколько свежих лотов смотреть в каждой коллекции за проход
PAGE_LIMIT=12

# Параллельных запросов к маркету
PARALLEL=8

# Курс: TON за 1 Star (для строки "X Stars / Y TON" в карточке)
TON_RATE=0.0102

# Часовой пояс времени в карточке (3 = МСК)
TZ_OFFSET=3

# v4.1 — лохи + персоны: девочки ~70%, тупые пацаны, без TGP
TRACKER_LOH_MODE=1
TRACKER_PERSONA_MODE=1
FEMALE_MIX_TARGET=0.70
TRACKER_FAST_SCAN=1
TRACKER_TURBO_SCAN=1
MAX_ACCOUNT_LEVEL=0
MAX_GIFTS_COUNT=1
MAX_STARS=2000
MIN_STARS=500
SCAN_BATCH=36
HOT_LIMIT=1
PAGE_LIMIT=2
POLL_INTERVAL=0.12
POST_INTERVAL=4
PARALLEL=6
REQUEST_GAP=0.08
TRACKER_STRICT_RU=1
