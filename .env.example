# Telegram Bot (уведомления)
BOT_TOKEN=123456:ABC-DEF

# Telegram MTProto — https://my.telegram.org (для авторизации в маркетах)
API_ID=12345678
API_HASH=your_api_hash

# Сессия Telethon (файл создаётся через: python -m bot.login)
TELETHON_SESSION=market_session

# Сколько Stars в 1 TON (для категорий цен). Подкрути под курс.
STARS_PER_TON=400

# Опрос маркетов, секунды
POLL_INTERVAL=2

# Какие маркеты слушать: tonnel,mrkt,portals
MARKETS=tonnel,mrkt,portals

# Опционально: готовые токены вместо Telethon (из DevTools)
# MRKT_TOKEN=
# PORTALS_AUTH=
# TONNEL_AUTH=
