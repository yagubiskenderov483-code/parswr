# Telegram API (my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Строка сессии юзербота — создаётся командой: python3 generate_session.py
SESSION_STRING=

# Токен бота @jsjeigiejwhnewbot от @BotFather (обязательно в env Bothost)
BOT_TOKEN=

# Канал для постов (id)
CHANNEL_ID=-1003784435307

# Диапазон цены в Stars
MIN_STARS=500
MAX_STARS=900

# Пауза между постами в канал (сек)
POST_INTERVAL=3
# Страниц resale на коллекцию за проход
SCAN_PAGES=2
PAGE_LIMIT=25

# Сколько свежих лотов смотреть в каждой коллекции за проход
PAGE_LIMIT=12

# Параллельных запросов к маркету
PARALLEL=8

# Курс: TON за 1 Star (для строки "X Stars / Y TON" в карточке)
TON_RATE=0.0102

# Часовой пояс времени в карточке (3 = МСК)
TZ_OFFSET=3
